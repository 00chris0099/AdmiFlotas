// ============================================================
// SAF - Sistema de Administracion de Flotas
// Manual F1T02 — Procedimientos Basicos de Operacion y Control
// Archivo: base.prisma — Generadores, fuente de datos y configuracion
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/prisma"
  previewFeatures = ["views"]
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: conductores.prisma — Esquema de Conductores y Personal (Normalizado)
// ============================================================

/// Personal del sistema de flotas F1T02 con roles jerárquicos según organigrama
model Usuario {
  id                  String    @id @default(uuid())
  nombre              String    @db.VarChar(100)
  apellido            String    @db.VarChar(100)
  email               String    @unique @db.VarChar(150)
  password            String?   @db.VarChar(255)
  rolId               String?   @map("rol_id")
  activo              Boolean   @default(true)
  telefono            String?   @db.VarChar(20)
  /// Número de licencia de conducir (requerido para conductores)
  licenciaConducir    String?   @map("licencia_conducir") @db.VarChar(30)
  /// Categoría de licencia (A, B, C, D — requerida para conductores)
  categoriaLicencia   String?   @map("categoria_licencia") @db.VarChar(5)
  /// Fecha de vencimiento de la licencia
  vencimientoLicencia DateTime? @map("vencimiento_licencia")
  /// Especialidad técnica (para mecánicos y electricistas)
  especialidad        String?   @db.VarChar(100)
  ultimoAcceso        DateTime? @map("ultimo_acceso")
  creadoEn            DateTime  @default(now()) @map("creado_en")
  actualizadoEn       DateTime  @updatedAt @map("actualizado_en")
  bloqueadoHasta      DateTime? @map("bloqueado_hasta")
  intentosFallidos    Int       @default(0) @map("intentos_fallidos")

  // Relaciones
  rol                  Rol?                 @relation(fields: [rolId], references: [id], onDelete: Restrict)
  permisos             PermisoUsuario[]
  sesionesAuth         SesionAuth[]
  auditoria            Auditoria[]
  tokensConfirmacion   TokenConfirmacion[]
  movimientosDiarios   MovimientoDiario[]   @relation("ConductorMovimiento")
  revisionesChecklist  MovimientoDiario[]   @relation("InspectorMovimiento")
  ordenesCombustible   OrdenCombustible[]
  ordenesMantenimiento OrdenMantenimiento[]
  asignaciones         AsignacionVehiculo[]
  programaciones       ProgramacionRuta[]

  @@index([rolId])
  @@index([activo])
  @@map("usuarios")
}

// ============================================================
// SAF - Sistema de AdministraciÃ³n de Flotas
// Archivo: configuracion.prisma â€” Esquema de ConfiguraciÃ³n General
// ============================================================

/// ParÃ¡metros generales del sistema SAF (nombre de la unidad, metas de km, etc.)
model ConfiguracionFlota {
  id            String   @id @default(uuid())
  clave         String   @unique @db.VarChar(100)
  valor         String
  descripcion   String?
  grupo         String   @default("general") @db.VarChar(50)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_flota")
}

// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: control_combustible.prisma — Esquema de Control de Combustible (Normalizado)
// ============================================================

/// Orden de abastecimiento de combustible y lubricantes — MA 122 01 02
model OrdenCombustible {
  id                  String               @id @default(uuid())
  /// Número de orden correlativo
  numeroOrden         String               @unique @map("numero_orden") @db.VarChar(20)
  fecha               DateTime             @db.Date
  vehiculoId          String               @map("vehiculo_id")
  conductorId         String               @map("conductor_id")
  sectorSolicitanteId String?              @map("sector_solicitante_id")
  tipoCombustible     TipoCombustibleOrden @map("tipo_combustible")
  /// Subtipo de combustible (ej. DIESEL_UBA, GASOLINA_95)
  subtipoCombustible  String?              @map("subtipo_combustible") @db.VarChar(50)

  // ─── Combustible ───
  cantidadGalones  Decimal? @map("cantidad_galones") @db.Decimal(8, 2)
  costoGalon       Decimal? @map("costo_galon") @db.Decimal(8, 3)
  costoCombustible Decimal? @map("costo_combustible") @db.Decimal(10, 2)

  // ─── Lubricante — Aceite de Motor (registrado por separado) ───
  /// Indica si esta orden incluye cambio/adición de aceite de motor
  incluyeAceiteMotor    Boolean  @default(false) @map("incluye_aceite_motor")
  cantidadAceiteMotorLt Decimal? @map("cantidad_aceite_motor_lt") @db.Decimal(6, 2)
  marcaAceiteMotor      String?  @map("marca_aceite_motor") @db.VarChar(80)
  viscosidadAceiteMotor String?  @map("viscosidad_aceite_motor") @db.VarChar(20)
  costoAceiteMotor      Decimal? @map("costo_aceite_motor") @db.Decimal(10, 2)

  // ─── Lubricante — Aceite de Caja/Transmisión (registrado por separado) ───
  /// Indica si esta orden incluye cambio de aceite de caja
  incluyeAceiteCaja    Boolean  @default(false) @map("incluye_aceite_caja")
  cantidadAceiteCajaLt Decimal? @map("cantidad_aceite_caja_lt") @db.Decimal(6, 2)
  marcaAceiteCaja      String?  @map("marca_aceite_caja") @db.VarChar(80)
  viscosidadAceiteCaja String?  @map("viscosidad_aceite_caja") @db.VarChar(20)
  costoAceiteCaja      Decimal? @map("costo_aceite_caja") @db.Decimal(10, 2)

  // ─── Costo Total de la Orden ───
  costoTotal Decimal @default(0) @map("costo_total") @db.Decimal(12, 2)

  // ─── Odómetro al momento del abastecimiento ───
  kilometrajeActual Int @map("kilometraje_actual")

  // ─── Datos del Servicentro Acreditado (Normalizado) ───
  centroServicioId         String? @map("centro_servicio_id")
  /// Número de ticket o factura del servicentro
  numeroTicketServiccentro String? @map("numero_ticket_serviccentro") @db.VarChar(50)
  /// Nombre del responsable que firma/sella en el servicentro
  responsableServiccentro  String? @map("responsable_serviccentro") @db.VarChar(100)
  /// Indica si se recibió el sello del servicentro
  selloServiccentro        Boolean @default(false) @map("sello_serviccentro")

  // ─── Solicitante ───
  /// Localidad donde está ubicado el sector del solicitante
  localidadSolicitante String? @map("localidad_solicitante") @db.VarChar(150)

  // ─── Firmas (MA 122 01 02 - F1T02) ───
  /// Firma del Encargado del Garaje
  firmaEncargadoGaraje String? @map("firma_encargado_garaje") @db.VarChar(100)
  /// Firma del Conductor del vehículo
  firmaConductor       String? @map("firma_conductor") @db.VarChar(100)
  /// Firma del Representante del Servicentro
  firmaServiccentro    String? @map("firma_servicentro") @db.VarChar(100)

  observaciones String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  vehiculo          Vehiculo              @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  conductor         Usuario               @relation(fields: [conductorId], references: [id], onDelete: Restrict)
  sectorSolicitante SectorOrganizacional? @relation(fields: [sectorSolicitanteId], references: [id], onDelete: SetNull)
  centroServicio    CentroServicio?       @relation(fields: [centroServicioId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([vehiculoId, fecha])
  @@index([conductorId])
  @@index([sectorSolicitanteId])
  @@index([centroServicioId])
  @@index([fecha])
  @@index([numeroOrden])
  @@map("ordenes_combustible")
}

/// Tipo de combustible o lubricante en la orden de abastecimiento
enum TipoCombustibleOrden {
  GASOLINA
  DIESEL
  GLP
  ACEITE_MOTOR
  ACEITE_CAJA
  MIXTO
}

// ============================================================
// SAF - Sistema de AdministraciÃ³n de Flotas
// Archivo: control_costos.prisma â€” Esquema de Control de Costos (Fijos y Consolidado)
// ============================================================

/// Costos fijos del Ã¡rea que se prorratean en el CKV (personal, oficina, etc.)
model CostoFijoProrrateable {
  id            String        @id @default(uuid())
  periodo       String        @db.VarChar(7)
  tipo          TipoCostoFijo
  descripcion   String        @db.VarChar(255)
  montoMensual  Decimal       @map("monto_mensual") @db.Decimal(12, 2)
  activo        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  @@index([periodo])
  @@index([tipo])
  @@map("costos_fijos_prorrateables")
}

/// Tipos de costos fijos prorrateables para el cÃ¡lculo CKV
enum TipoCostoFijo {
  PERSONAL_ADMINISTRATIVO
  OFICINA
  COMUNICACIONES
  SEGUROS_GENERALES
  LICENCIAS_SOFTWARE
  OTROS
}

/// Vista de base de datos para el reporte consolidado de costos operacionales mensuales por vehÃ­culo
view ReporteMensualCostos {
  /// Identificador Ãºnico (ficticio o real) requerido para Prisma Client
  id                   String  @unique
  vehiculoId           String  @map("vehiculo_id")
  periodo              String  @db.VarChar(7) // Formato: YYYY-MM
  costoCombustible     Decimal @map("costo_combustible") @db.Decimal(12, 2)
  costoMantenimiento   Decimal @map("costo_mantenimiento") @db.Decimal(12, 2)
  costoFijoProrrateado Decimal @map("costo_fijo_prorrateado") @db.Decimal(12, 2)
  costoTotal           Decimal @map("costo_total") @db.Decimal(12, 2)

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("v_reporte_mensual_costos")
}

/// Vista analÃ­tica consolidada de KPIs de rendimiento y coste por vehÃ­culo
view ResumenKpisVehiculo {
  id                 String  @unique
  vehiculoId         String  @map("vehiculo_id")
  marca              String
  modelo             String
  placa              String
  kilometrajeTotal   Int     @map("kilometraje_total")
  horasUtilizacion   Decimal @map("horas_utilizacion") @db.Decimal(10, 2)
  galonesCombustible Decimal @map("galones_combustible") @db.Decimal(10, 2)
  costoCombustible   Decimal @map("costo_combustible") @db.Decimal(12, 2)
  costoMantenimiento Decimal @map("costo_mantenimiento") @db.Decimal(12, 2)
  viajesRealizados   Int     @map("viajes_realizados")

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("v_resumen_kpis_vehiculo")
}

// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: control_llantas.prisma — Esquema de Control de Llantas (Normalizado)
// ============================================================

/// Control individualizado de llantas: código EPS, posición, kilometraje acumulado
model ControlLlanta {
  id                     String       @id @default(uuid())
  /// Código único de la llanta (Número EPS del fabricante)
  codigoEps              String       @unique @map("codigo_eps") @db.VarChar(50)
  vehiculoId             String       @map("vehiculo_id")
  fabricanteId           String?      @map("fabricante_id")
  dimensionId            String?      @map("dimension_id")
  modeloLlanta           String       @map("modelo_llanta") @db.VarChar(80)
  /// Posición en el vehículo según diagrama del manual (1–7)
  posicionVehiculo       Int          @map("posicion_vehiculo")
  /// Descripción textual de la posición (ej. "Delantera Izquierda")
  descripcionPosicion    String?      @map("descripcion_posicion") @db.VarChar(50)
  estado                 EstadoLlanta @default(EN_USO)
  fechaInstalacion       DateTime     @map("fecha_instalacion")
  fechaRetiro            DateTime?    @map("fecha_retiro")
  /// Kilometraje del vehículo al momento de instalar la llanta
  kilometrajeInstalacion Int          @map("kilometraje_instalacion")
  /// Kilometraje del vehículo al momento de retirar la llanta
  kilometrajeRetiro      Int?         @map("kilometraje_retiro")
  /// Km recorridos con esta llanta = kmRetiro - kmInstalacion
  kilometrajeAcumulado   Int          @default(0) @map("kilometraje_acumulado")
  /// Número de veces que ha sido reencauchada
  vecesReencauchada      Int          @default(0) @map("veces_reencauchada")
  /// Costo de adquisición de la llanta
  costoAdquisicion       Decimal?     @map("costo_adquisicion") @db.Decimal(10, 2)
  observaciones          String?
  creadoEn               DateTime     @default(now()) @map("creado_en")
  actualizadoEn          DateTime     @updatedAt @map("actualizado_en")

  // Relaciones
  vehiculo   Vehiculo          @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  fabricante FabricanteLlanta? @relation(fields: [fabricanteId], references: [id], onDelete: Restrict)
  dimension  DimensionLlanta?  @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@index([vehiculoId])
  @@index([fabricanteId])
  @@index([dimensionId])
  @@index([estado])
  @@index([codigoEps])
  @@index([fechaInstalacion])
  @@index([posicionVehiculo])
  @@map("control_llantas")
}

/// Estado de una llanta según su ciclo de vida
enum EstadoLlanta {
  EN_USO
  EN_ALMACEN
  REENCAUCHADA
  EN_REENCAUCHE
  DADA_DE_BAJA
}

/// Vista analítica de desempeño y coste por kilómetro de neumáticos
view DesempenoLlantas {
  id                   String   @unique
  codigoEps            String   @map("codigo_eps")
  vehiculoId           String   @map("vehiculo_id")
  fabricante           String
  kilometrajeAcumulado Int      @map("kilometraje_acumulado")
  vecesReencauchada    Int      @map("veces_reencauchada")
  costoAdquisicion     Decimal? @map("costo_adquisicion") @db.Decimal(10, 2)
  costoPorKm           Decimal? @map("costo_por_km") @db.Decimal(10, 4)

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("v_desempeno_llantas")
}

// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: control_mantenimiento.prisma — Esquema de Control de Mantenimiento (Normalizado)
// ============================================================

/// Orden de mantenimiento preventivo o correctivo — MA 122 02 01
model OrdenMantenimiento {
  id                  String            @id @default(uuid())
  /// Número de orden correlativo de mantenimiento
  numeroOrden         String            @unique @map("numero_orden") @db.VarChar(20)
  fechaEmision        DateTime          @map("fecha_emision") @db.Date
  vehiculoId          String            @map("vehiculo_id")
  /// Técnico responsable de ejecutar el mantenimiento
  tecnicoId           String?           @map("tecnico_id")
  sectorSolicitanteId String?           @map("sector_solicitante_id")
  tipoMantenimiento   TipoMantenimiento @map("tipo_mantenimiento")

  // ─── Tipo de Taller ───
  /// Origen del servicio: Taller Propio (con Tarjeta de Mano de Obra)
  /// o Taller de Terceros (con Autorización de Servicio Externo)
  tipoTaller                TipoTaller @map("tipo_taller")
  /// Nombre del taller de terceros (si aplica)
  nombreTallerExterno       String?    @map("nombre_taller_externo") @db.VarChar(150)
  /// Número de autorización de servicio externo (si aplica)
  numeroAutorizacionExterna String?    @map("numero_autorizacion_externa") @db.VarChar(50)

  // ─── Entrada y Salida del Taller ───
  fechaEntradaTaller DateTime? @map("fecha_entrada_taller") @db.Date
  horaEntradaTaller  String?   @map("hora_entrada_taller") @db.VarChar(5)
  fechaSalidaTaller  DateTime? @map("fecha_salida_taller") @db.Date
  horaSalidaTaller   String?   @map("hora_salida_taller") @db.VarChar(5)

  // ─── Odómetro ───
  kilometrajeEntrada Int? @map("kilometraje_entrada")
  kilometrajeSalida  Int? @map("kilometraje_salida")

  // ─── Descripción del Servicio ───
  descripcionServicio String
  /// Falla reportada por el conductor (para correctivo)
  fallaReportada      String? @map("falla_reportada")
  /// Diagnóstico del técnico
  diagnosticoTecnico  String? @map("diagnostico_tecnico")

  // ─── Desglose de Costos (Taller Propio) ───
  /// Costo de mano de obra propia (en base a Tarjeta de Mano de Obra)
  costoManoObraPropia   Decimal? @map("costo_mano_obra_propia") @db.Decimal(12, 2)
  /// Costo de mano de obra de terceros (factura del taller externo)
  costoManoObraTerceros Decimal? @map("costo_mano_obra_terceros") @db.Decimal(12, 2)
  /// Costo total de piezas y repuestos del Almacén de Mantenimiento
  costoPiezasRepuestos  Decimal? @default(0) @map("costo_piezas_repuestos") @db.Decimal(12, 2)
  /// Otros costos (traslado, peritaje, etc.)
  costoOtros            Decimal? @default(0) @map("costo_otros") @db.Decimal(12, 2)
  /// Costo total de la orden (calculado: MO + Piezas + Otros)
  costoTotal            Decimal? @map("costo_total") @db.Decimal(12, 2)

  // Firmas Digitales
  firmaEncargadoTaller   String?   @map("firma_encargado_taller") @db.VarChar(100)
  firmaTecnico           String?   @map("firma_tecnico") @db.VarChar(100)
  firmaJefeMantenimiento String?   @map("firma_jefe_mantenimiento") @db.VarChar(100)
  fechaFirmaTecnico      DateTime? @map("fecha_firma_tecnico")

  // ─── Estado ───
  estado        EstadoMantenimiento @default(PENDIENTE)
  observaciones String?
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  // ─── Relaciones ───
  vehiculo          Vehiculo              @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  tecnico           Usuario?              @relation(fields: [tecnicoId], references: [id], onDelete: Restrict)
  sectorSolicitante SectorOrganizacional? @relation(fields: [sectorSolicitanteId], references: [id], onDelete: SetNull)
  repuestos         DetalleRepuesto[]
  manoDeObra        DetalleManoObra[]

  @@index([vehiculoId])
  @@index([vehiculoId, fechaEmision])
  @@index([tecnicoId])
  @@index([sectorSolicitanteId])
  @@index([tipoMantenimiento])
  @@index([tipoTaller])
  @@index([estado])
  @@index([fechaEmision])
  @@map("ordenes_mantenimiento")
}

/// Detalle de repuestos y piezas por orden de mantenimiento (Almacén de Mantenimiento)
model DetalleRepuesto {
  id                   String   @id @default(uuid())
  ordenMantenimientoId String   @map("orden_mantenimiento_id")
  descripcion          String   @db.VarChar(255)
  /// Número de parte según catálogo del fabricante
  numeroParteCatalogo  String?  @map("numero_parte_catalogo") @db.VarChar(80)
  unidadMedida         String   @default("unidad") @map("unidad_medida") @db.VarChar(30)
  cantidad             Decimal  @db.Decimal(10, 3)
  precioUnitario       Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  subtotal             Decimal  @db.Decimal(12, 2)
  /// Indica si el repuesto proviene del Almacén de Mantenimiento propio
  esAlmacenPropio      Boolean  @default(true) @map("es_almacen_propio")
  proveedor            String?  @db.VarChar(150)
  creadoEn             DateTime @default(now()) @map("creado_en")

  ordenMantenimiento OrdenMantenimiento @relation(fields: [ordenMantenimientoId], references: [id], onDelete: Cascade)

  @@index([ordenMantenimientoId])
  @@map("detalle_repuestos")
}

/// Detalle de mano de obra por técnico — vinculado a Tarjeta de Mano de Obra
model DetalleManoObra {
  id                   String   @id @default(uuid())
  ordenMantenimientoId String   @map("orden_mantenimiento_id")
  descripcionTarea     String   @map("descripcion_tarea") @db.VarChar(255)
  horasTrabajadas      Decimal  @map("horas_trabajadas") @db.Decimal(6, 2)
  costoHora            Decimal  @map("costo_hora") @db.Decimal(8, 2)
  subtotal             Decimal  @db.Decimal(10, 2)
  /// Nombre del técnico ejecutor (puede ser de taller propio o externo)
  nombreTecnico        String?  @map("nombre_tecnico") @db.VarChar(100)
  creadoEn             DateTime @default(now()) @map("creado_en")

  ordenMantenimiento OrdenMantenimiento @relation(fields: [ordenMantenimientoId], references: [id], onDelete: Cascade)

  @@index([ordenMantenimientoId])
  @@map("detalle_mano_obra")
}

/// Tipo de mantenimiento (MA 122 02 01)
enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

/// Origen del servicio de mantenimiento
enum TipoTaller {
  PROPIO
  TERCEROS
}

/// Estado de la orden de mantenimiento
enum EstadoMantenimiento {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model AsignacionVehiculo {
  id              String    @id @default(uuid())
  vehiculoId      String    @map("vehiculo_id")
  conductorId     String    @map("conductor_id")
  sectorAsignado  String    @map("sector_asignado") @db.VarChar(150)
  fechaAsignacion DateTime  @default(now()) @map("fecha_asignacion")
  fechaFin        DateTime? @map("fecha_fin")
  activa          Boolean   @default(true)
  observaciones   String?
  creadoEn        DateTime  @default(now()) @map("creado_en")

  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [id])
  conductor Usuario  @relation(fields: [conductorId], references: [id])

  @@index([vehiculoId])
  @@index([conductorId])
  @@index([activa])
  @@map("asignaciones_vehiculos")
}

model DocumentoVehiculo {
  id               String        @id @default(uuid())
  vehiculoId       String        @map("vehiculo_id")
  tipoDocumento    TipoDocumento @map("tipo_documento")
  numeroDocumento  String        @map("numero_documento") @db.VarChar(50)
  fechaEmision     DateTime      @map("fecha_emision")
  fechaVencimiento DateTime?     @map("fecha_vencimiento")
  entidadEmisora   String?       @map("entidad_emisora") @db.VarChar(150)
  observaciones    String?
  creadoEn         DateTime      @default(now()) @map("creado_en")

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId])
  @@index([tipoDocumento])
  @@index([fechaVencimiento])
  @@map("documentos_vehiculo")
}

enum TipoDocumento {
  LICENCIA
  SOAT
  REVISION_TECNICA
  SEGURO
  TARJETA_PROPIEDAD
  OTRO
}

// ============================================================
// SAF - Sistema de Administración de Flotas
// Manual F1T02 — Procedimientos Básicos de Operación y Control
// Archivo: mantenimiento.prisma — Almacén de Mantenimiento (Normalizado)
// ============================================================

/// Repuesto del Almacén de Mantenimiento — MA 122 02 01
model Repuesto {
  id             String   @id @default(uuid())
  /// Código único del repuesto en el almacén
  codigo         String   @unique @db.VarChar(50)
  descripcion    String   @db.VarChar(255)
  categoriaId    String?  @map("categoria_id")
  unidadMedida   String   @default("unidad") @map("unidad_medida") @db.VarChar(30)
  stockActual    Int      @default(0) @map("stock_actual")
  stockMinimo    Int      @default(0) @map("stock_minimo")
  precioUnitario Decimal? @map("precio_unitario") @db.Decimal(10, 2)
  creadoEn       DateTime @default(now()) @map("creado_en")

  categoria   CategoriaRepuesto?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  movimientos MovimientoAlmacen[]

  @@index([categoriaId])
  @@map("repuestos")
}

/// Movimiento de entrada/salida en el Almacén de Mantenimiento
model MovimientoAlmacen {
  id                      String   @id @default(uuid())
  repuestoId              String   @map("repuesto_id")
  tipoMovimientoAlmacenId String?  @map("tipo_movimiento_almacen_id")
  cantidad                Int
  ordenMantenimientoId    String?  @map("orden_mantenimiento_id")
  responsable             String   @db.VarChar(100)
  fecha                   DateTime @default(now())
  observaciones           String?

  repuesto       Repuesto               @relation(fields: [repuestoId], references: [id])
  tipoMovimiento TipoMovimientoAlmacen? @relation(fields: [tipoMovimientoAlmacenId], references: [id], onDelete: SetNull)

  @@index([repuestoId])
  @@index([tipoMovimientoAlmacenId])
  @@index([fecha])
  @@map("movimientos_almacen")
}

model Lavado {
  id            String   @id @default(uuid())
  vehiculoId    String   @map("vehiculo_id")
  fecha         DateTime @db.Date
  tipoLavadoId  String?  @map("tipo_lavado_id")
  costo         Decimal? @db.Decimal(8, 2)
  proveedor     String?  @db.VarChar(150)
  responsable   String?  @db.VarChar(100)
