// ============================================================

/// Registro de uso diario del vehÃ­culo â€” Formulario MA 122 01 01
model MovimientoDiario {
  id                String   @id @default(uuid())
  vehiculoId        String   @map("vehiculo_id")
  conductorId       String   @map("conductor_id")
  /// Inspector que valida el checklist pre-operacional
  inspectorId       String?  @map("inspector_id")
  fecha             DateTime @db.Date
  sectorSolicitante String   @map("sector_solicitante") @db.VarChar(150)
  destino           String   @db.VarChar(200)
  proposito         String?  @db.VarChar(255)

  // â”€â”€ OdÃ³metro â”€â”€
  kilometrajeSalida    Int  @map("kilometraje_salida")
  kilometrajeLlegada   Int? @map("kilometraje_llegada")
  /// Km recorridos en el dÃ­a = kmLlegada - kmSalida (calculado)
  kilometrajeRecorrido Int? @map("kilometraje_recorrido")

