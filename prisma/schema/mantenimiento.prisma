/// Repuesto del Almacén de Mantenimiento — MA 122 02 01
model Repuesto {
  id              String   @id @default(uuid())
  /// Código único del repuesto en el almacén
  codigo          String   @unique @db.VarChar(50)
  descripcion     String   @db.VarChar(255)
  categoriaId     String?  @map("categoria_id")
  unidadMedida    String   @default("unidad") @map("unidad_medida") @db.VarChar(30)
  stockActual     Int      @default(0) @map("stock_actual")
  stockMinimo     Int      @default(0) @map("stock_minimo")
  precioUnitario  Decimal? @map("precio_unitario") @db.Decimal(10, 2)
  creadoEn        DateTime @default(now()) @map("creado_en")

  categoria   CategoriaRepuesto? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  movimientos MovimientoAlmacen[]

  @@index([categoriaId])
  @@map("repuestos")
}

/// Movimiento de entrada/salida en el Almacén de Mantenimiento
model MovimientoAlmacen {
  id                      String   @id @default(uuid())
  repuestoId              String   @map("repuesto_id")
  tipoMovimientoAlmacenId String?  @map("tipo_movimiento_almacen_id")
  cantidad                Int
  ordenMantenimientoId    String?  @map("orden_mantenimiento_id")
  responsable             String   @db.VarChar(100)
  fecha                   DateTime @default(now())
  observaciones           String?

  repuesto        Repuesto                @relation(fields: [repuestoId], references: [id])
  tipoMovimiento  TipoMovimientoAlmacen?  @relation(fields: [tipoMovimientoAlmacenId], references: [id], onDelete: SetNull)

  @@index([repuestoId])
  @@index([tipoMovimientoAlmacenId])
  @@index([fecha])
  @@map("movimientos_almacen")
}

model Lavado {
  id              String   @id @default(uuid())
  vehiculoId      String   @map("vehiculo_id")
  fecha           DateTime @db.Date
  tipoLavadoId    String?  @map("tipo_lavado_id")
  costo           Decimal? @db.Decimal(8, 2)
  proveedor       String?  @db.VarChar(150)
  responsable     String?  @db.VarChar(100)
  observaciones   String?
  creadoEn        DateTime @default(now()) @map("creado_en")

  vehiculo   Vehiculo     @relation(fields: [vehiculoId], references: [id])
  tipoLavado TipoLavado?  @relation(fields: [tipoLavadoId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([tipoLavadoId])
  @@index([fecha])
  @@map("lavados")
}
