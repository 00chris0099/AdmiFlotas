// ============================================================
// SAF - Sistema de Administración de Flotas
// Manual F1T02 — Procedimientos Básicos de Operación y Control
// Archivo: operacion.prisma — Movimiento Diario, Combustible y Mantenimiento
//
// Formularios MA implementados:
//   MA 122 01 01 → MovimientoDiario + ChecklistVerificacion
//   MA 122 01 02 → OrdenCombustible (incluye lubricantes por separado)
//   MA 122 02 01 → OrdenMantenimiento + DetalleRepuesto + DetalleManodeObra
// ============================================================

// ────────────────────────────────────────────────────────────
// MODELO: MovimientoDiario — Formulario MA 122 01 01
// Registra el uso diario de cada vehículo: odómetro, horas de uso,
// conductor, destino y el checklist de verificación pre-operacional.
// Las horas efectivas (HUV) son indispensables para calcular el
// Índice de Utilización del Vehículo (IUV = HorasReales / HorasEstándar).
// ────────────────────────────────────────────────────────────
/// Registro de uso diario del vehículo — Formulario MA 122 01 01
model MovimientoDiario {
  id                String   @id @default(uuid())
  vehiculoId        String   @map("vehiculo_id")
  conductorId       String   @map("conductor_id")
  /// Inspector que valida el checklist pre-operacional
  inspectorId       String?  @map("inspector_id")
  fecha             DateTime @db.Date
  sectorSolicitante String   @map("sector_solicitante") @db.VarChar(150)
  destino           String   @db.VarChar(200)
  proposito         String?  @db.VarChar(255)

  // ── Odómetro ──
  kilometrajeSalida    Int  @map("kilometraje_salida")
  kilometrajeLlegada   Int? @map("kilometraje_llegada")
  /// Km recorridos en el día = kmLlegada - kmSalida (calculado)
  kilometrajeRecorrido Int? @map("kilometraje_recorrido")

  // ── Horas de Utilización del Vehículo (HUV) ──
  /// Hora de salida del vehículo (formato HH:MM)
  horaSalida       String   @map("hora_salida") @db.VarChar(5)
  /// Hora de llegada del vehículo (formato HH:MM)
  horaLlegada      String?  @map("hora_llegada") @db.VarChar(5)
  /// Horas efectivas de utilización del vehículo en el día
  horasUtilizacion Decimal? @map("horas_utilizacion") @db.Decimal(5, 2)

  // ── Estado ──
  estado        EstadoMovimiento @default(EN_RUTA)
  observaciones String?
  creadoEn      DateTime         @default(now()) @map("creado_en")
  actualizadoEn DateTime         @updatedAt @map("actualizado_en")

  // ── Relaciones ──
  vehiculo  Vehiculo               @relation(fields: [vehiculoId], references: [id])
  conductor Usuario                @relation("ConductorMovimiento", fields: [conductorId], references: [id])
  inspector Usuario?               @relation("InspectorMovimiento", fields: [inspectorId], references: [id])
  checklist ChecklistVerificacion?

  @@index([vehiculoId])
  @@index([conductorId])
  @@index([fecha])
  @@index([estado])
  @@map("movimientos_diarios")
}

// ────────────────────────────────────────────────────────────
// MODELO: ChecklistVerificacion — 15 puntos de control pre-operacional
// Vinculado 1:1 con MovimientoDiario. Registra el estado de cada
// punto de control antes de la salida del vehículo.
// Valores: OK (correcto), OBSERVADO (con nota), FALLADO (no pasa)
// ────────────────────────────────────────────────────────────
/// Checklist de verificación diaria pre-operacional (15 puntos — MA 122 01 01)
model ChecklistVerificacion {
  id           String @id @default(uuid())
  movimientoId String @unique @map("movimiento_id")

  // ── Punto 1: Documentos del vehículo ──
  documentos       EstadoChecklist @default(OK)
  observDocumentos String?         @map("observ_documentos")

  // ── Punto 2: Nivel de aceite de motor ──
  aceiteMotor       EstadoChecklist @default(OK) @map("aceite_motor")
  observAceiteMotor String?         @map("observ_aceite_motor")

  // ── Punto 3: Nivel de agua del radiador ──
  agua       EstadoChecklist @default(OK)
  observAgua String?         @map("observ_agua")

  // ── Punto 4: Batería (nivel de electrolito, bornes) ──
  bateria       EstadoChecklist @default(OK)
  observBateria String?         @map("observ_bateria")

  // ── Punto 5: Sistema de frenos (líquido y funcionamiento) ──
  frenos       EstadoChecklist @default(OK)
  observFrenos String?         @map("observ_frenos")

  // ── Punto 6: Embrague (líquido y funcionamiento) ──
  embrague       EstadoChecklist @default(OK)
  observEmbrague String?         @map("observ_embrague")

  // ── Punto 7: Fajas / Correas (alternador, distribución) ──
  fajas       EstadoChecklist @default(OK)
  observFajas String?         @map("observ_fajas")

  // ── Punto 8: Faros (delanteros, traseros, de freno) ──
  faros       EstadoChecklist @default(OK)
  observFaros String?         @map("observ_faros")

  // ── Punto 9: Lunas / Vidrios ──
  lunas       EstadoChecklist @default(OK)
  observLunas String?         @map("observ_lunas")

  // ── Punto 10: Plumillas / Limpiaparabrisas ──
  plumillas       EstadoChecklist @default(OK)
  observPlumillas String?         @map("observ_plumillas")

  // ── Punto 11: Presión y estado de llantas ──
  llantas       EstadoChecklist @default(OK)
  observLlantas String?         @map("observ_llantas")

  // ── Punto 12: Espejos retrovisores ──
  espejos       EstadoChecklist @default(OK)
  observEspejos String?         @map("observ_espejos")

  // ── Punto 13: Herramientas y equipo de emergencia ──
  herramientas       EstadoChecklist @default(OK)
  observHerramientas String?         @map("observ_herramientas")

  // ── Punto 14: Extintor y botiquín ──
  extintorBotiquin       EstadoChecklist @default(OK) @map("extintor_botiquin")
  observExtintorBotiquin String?         @map("observ_extintor_botiquin")

  // ── Punto 15: Manchas por fugas en el estacionamiento ──
  manchasFugas       EstadoChecklist @default(OK) @map("manchas_fugas")
  observManchasFugas String?         @map("observ_manchas_fugas")

  // ── Resultado General ──
  aptoParaOperar         Boolean  @default(true) @map("apto_para_operar")
  observacionesGenerales String?  @map("observaciones_generales")
  firmaConductor         String?  @map("firma_conductor") @db.VarChar(100)
  firmaInspector         String?  @map("firma_inspector") @db.VarChar(100)
  fechaRegistro          DateTime @default(now()) @map("fecha_registro")

  movimiento MovimientoDiario @relation(fields: [movimientoId], references: [id], onDelete: Cascade)

  @@map("checklist_verificacion")
}

// ────────────────────────────────────────────────────────────
// MODELO: OrdenCombustible — Formulario MA 122 01 02
// Registra el abastecimiento de combustible Y lubricantes por separado,
// ya que tienen costos y periodicidades de cambio distintas.
// Incluye identificación del servicentro acreditado.
// ────────────────────────────────────────────────────────────
/// Orden de abastecimiento de combustible y lubricantes — MA 122 01 02
model OrdenCombustible {
  id                String               @id @default(uuid())
  /// Número de orden correlativo
  numeroOrden       String               @unique @map("numero_orden") @db.VarChar(20)
  fecha             DateTime             @db.Date
  vehiculoId        String               @map("vehiculo_id")
  conductorId       String               @map("conductor_id")
  sectorSolicitante String               @map("sector_solicitante") @db.VarChar(150)
  tipoCombustible   TipoCombustibleOrden @map("tipo_combustible")

  // ── Combustible ──
  cantidadGalones  Decimal? @map("cantidad_galones") @db.Decimal(8, 2)
  costoGalon       Decimal? @map("costo_galon") @db.Decimal(8, 3)
  costoCombustible Decimal? @map("costo_combustible") @db.Decimal(10, 2)

  // ── Lubricante — Aceite de Motor (registrado por separado) ──
  /// Indica si esta orden incluye cambio/adición de aceite de motor
  incluyeAceiteMotor    Boolean  @default(false) @map("incluye_aceite_motor")
  cantidadAceiteMotorLt Decimal? @map("cantidad_aceite_motor_lt") @db.Decimal(6, 2)
  marcaAceiteMotor      String?  @map("marca_aceite_motor") @db.VarChar(80)
  viscosidadAceiteMotor String?  @map("viscosidad_aceite_motor") @db.VarChar(20)
  costoAceiteMotor      Decimal? @map("costo_aceite_motor") @db.Decimal(10, 2)

  // ── Lubricante — Aceite de Caja/Transmisión (registrado por separado) ──
  /// Indica si esta orden incluye cambio de aceite de caja
  incluyeAceiteCaja    Boolean  @default(false) @map("incluye_aceite_caja")
  cantidadAceiteCajaLt Decimal? @map("cantidad_aceite_caja_lt") @db.Decimal(6, 2)
  marcaAceiteCaja      String?  @map("marca_aceite_caja") @db.VarChar(80)
  viscosidadAceiteCaja String?  @map("viscosidad_aceite_caja") @db.VarChar(20)
  costoAceiteCaja      Decimal? @map("costo_aceite_caja") @db.Decimal(10, 2)

  // ── Costo Total de la Orden ──
  costoTotal Decimal @default(0) @map("costo_total") @db.Decimal(12, 2)

  // ── Odómetro al momento del abastecimiento ──
  kilometrajeActual Int @map("kilometraje_actual")

  // ── Datos del Servicentro Acreditado ──
  nombreServiccentro       String? @map("nombre_serviccentro") @db.VarChar(150)
  direccionServiccentro    String? @map("direccion_serviccentro")
  /// Número de ticket o factura del servicentro
  numeroTicketServiccentro String? @map("numero_ticket_serviccentro") @db.VarChar(50)
  /// Nombre del responsable que firma/sella en el servicentro
  responsableServiccentro  String? @map("responsable_serviccentro") @db.VarChar(100)
  /// Indica si se recibió el sello del servicentro
  sellServiccentro         Boolean @default(false) @map("sello_serviccentro")

  observaciones String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [id])
  conductor Usuario  @relation(fields: [conductorId], references: [id])

  @@index([vehiculoId])
  @@index([conductorId])
  @@index([fecha])
  @@index([numeroOrden])
  @@map("ordenes_combustible")
}

// ────────────────────────────────────────────────────────────
// MODELO: OrdenMantenimiento — Formulario MA 122 02 01
// Registra órdenes de mantenimiento preventivo y correctivo.
// Diferencia explícita entre Taller Propio (vinculado a Tarjeta de
// Mano de Obra de mecánicos del equipo) y Taller de Terceros
// (vinculado a una Autorización de Servicio Externo).
// Incluye desglose de costos: Mano de Obra, Repuestos/Piezas y Otros.
// Los repuestos se controlan en DetalleRepuesto (integración con
// el Almacén de Mantenimiento del manual F1T02).
// ────────────────────────────────────────────────────────────
/// Orden de mantenimiento preventivo o correctivo — MA 122 02 01
model OrdenMantenimiento {
  id                String            @id @default(uuid())
  /// Número de orden correlativo de mantenimiento
  numeroOrden       String            @unique @map("numero_orden") @db.VarChar(20)
  fechaEmision      DateTime          @map("fecha_emision") @db.Date
  vehiculoId        String            @map("vehiculo_id")
  /// Técnico responsable de ejecutar el mantenimiento
  tecnicoId         String?           @map("tecnico_id")
  sectorSolicitante String            @map("sector_solicitante") @db.VarChar(150)
  tipoMantenimiento TipoMantenimiento @map("tipo_mantenimiento")

  // ── Tipo de Taller ──
  /// Origen del servicio: Taller Propio (con Tarjeta de Mano de Obra)
  /// o Taller de Terceros (con Autorización de Servicio Externo)
  tipoTaller                TipoTaller @map("tipo_taller")
  /// Nombre del taller de terceros (si aplica)
  nombreTallerExterno       String?    @map("nombre_taller_externo") @db.VarChar(150)
  /// Número de autorización de servicio externo (si aplica)
  numeroAutorizacionExterna String?    @map("numero_autorizacion_externa") @db.VarChar(50)

  // ── Entrada y Salida del Taller ──
  fechaEntradaTaller DateTime? @map("fecha_entrada_taller") @db.Date
  horaEntradaTaller  String?   @map("hora_entrada_taller") @db.VarChar(5)
  fechaSalidaTaller  DateTime? @map("fecha_salida_taller") @db.Date
  horaSalidaTaller   String?   @map("hora_salida_taller") @db.VarChar(5)

  // ── Odómetro ──
  kilometrajeEntrada Int? @map("kilometraje_entrada")
  kilometrajeSalida  Int? @map("kilometraje_salida")

  // ── Descripción del Servicio ──
  descripcionServicio String
  /// Falla reportada por el conductor (para correctivo)
  fallaReportada      String? @map("falla_reportada")
  /// Diagnóstico del técnico
  diagnosticoTecnico  String? @map("diagnostico_tecnico")

  // ── Desglose de Costos (Taller Propio) ──
  /// Costo de mano de obra propia (en base a Tarjeta de Mano de Obra)
  costoManoObraPropia   Decimal? @map("costo_mano_obra_propia") @db.Decimal(12, 2)
  /// Costo de mano de obra de terceros (factura del taller externo)
  costoManoObraTerceros Decimal? @map("costo_mano_obra_terceros") @db.Decimal(12, 2)
  /// Costo total de piezas y repuestos del Almacén de Mantenimiento
  costoPiezasRepuestos  Decimal? @default(0) @map("costo_piezas_repuestos") @db.Decimal(12, 2)
  /// Otros costos (traslado, peritaje, etc.)
  costoOtros            Decimal? @default(0) @map("costo_otros") @db.Decimal(12, 2)
  /// Costo total de la orden (calculado: MO + Piezas + Otros)
  costoTotal            Decimal? @map("costo_total") @db.Decimal(12, 2)

  // ── Estado ──
  estado        EstadoMantenimiento @default(PENDIENTE)
  observaciones String?
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  // ── Relaciones ──
  vehiculo   Vehiculo          @relation(fields: [vehiculoId], references: [id])
  tecnico    Usuario?          @relation(fields: [tecnicoId], references: [id])
  repuestos  DetalleRepuesto[]
  manoDeObra DetalleManoObra[]

  @@index([vehiculoId])
  @@index([tipoMantenimiento])
  @@index([tipoTaller])
  @@index([estado])
  @@index([fechaEmision])
  @@map("ordenes_mantenimiento")
}

// ────────────────────────────────────────────────────────────
// MODELO: DetalleRepuesto
// Piezas y repuestos utilizados en cada orden de mantenimiento.
// Corresponde al control de materiales del Almacén de Mantenimiento.
// Permite calcular el costo variable de piezas/repuestos del CKV.
// ────────────────────────────────────────────────────────────
/// Detalle de repuestos y piezas por orden de mantenimiento (Almacén de Mantenimiento)
model DetalleRepuesto {
  id                   String   @id @default(uuid())
  ordenMantenimientoId String   @map("orden_mantenimiento_id")
  descripcion          String   @db.VarChar(255)
  /// Número de parte según catálogo del fabricante
  numeroParteCatalogo  String?  @map("numero_parte_catalogo") @db.VarChar(80)
  unidadMedida         String   @default("unidad") @map("unidad_medida") @db.VarChar(30)
  cantidad             Decimal  @db.Decimal(10, 3)
  precioUnitario       Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  subtotal             Decimal  @db.Decimal(12, 2)
  /// Indica si el repuesto proviene del Almacén de Mantenimiento propio
  esAlmacenPropio      Boolean  @default(true) @map("es_almacen_propio")
  proveedor            String?  @db.VarChar(150)
  creadoEn             DateTime @default(now()) @map("creado_en")

  ordenMantenimiento OrdenMantenimiento @relation(fields: [ordenMantenimientoId], references: [id], onDelete: Cascade)

  @@index([ordenMantenimientoId])
  @@map("detalle_repuestos")
}

// ────────────────────────────────────────────────────────────
// MODELO: DetalleManoObra
// Registro de horas de trabajo por técnico en cada orden.
// Vinculado a la Tarjeta de Mano de Obra de los mecánicos
// del Equipo de Mantenimiento (rol MECANICO / ELECTRICISTA).
// ────────────────────────────────────────────────────────────
/// Detalle de mano de obra por técnico — vinculado a Tarjeta de Mano de Obra
model DetalleManoObra {
  id                   String   @id @default(uuid())
  ordenMantenimientoId String   @map("orden_mantenimiento_id")
  descripcionTarea     String   @map("descripcion_tarea") @db.VarChar(255)
  horasTrabajadas      Decimal  @map("horas_trabajadas") @db.Decimal(6, 2)
  costoHora            Decimal  @map("costo_hora") @db.Decimal(8, 2)
  subtotal             Decimal  @db.Decimal(10, 2)
  /// Nombre del técnico ejecutor (puede ser de taller propio o externo)
  nombreTecnico        String?  @map("nombre_tecnico") @db.VarChar(100)
  creadoEn             DateTime @default(now()) @map("creado_en")

  ordenMantenimiento OrdenMantenimiento @relation(fields: [ordenMantenimientoId], references: [id], onDelete: Cascade)

  @@index([ordenMantenimientoId])
  @@map("detalle_mano_obra")
}

// ────────────────────────────────────────────────────────────
// ENUMs de Operación
// ────────────────────────────────────────────────────────────

/// Estado del movimiento diario del vehículo
enum EstadoMovimiento {
  PROGRAMADO
  EN_RUTA
  COMPLETADO
  CANCELADO
}

/// Estado de cada punto del checklist de verificación
enum EstadoChecklist {
  OK
  OBSERVADO
  FALLADO
}

/// Tipo de combustible o lubricante en la orden de abastecimiento
enum TipoCombustibleOrden {
  GASOLINA
  DIESEL
  GLP
  ACEITE_MOTOR
  ACEITE_CAJA
  MIXTO
}

/// Tipo de mantenimiento (MA 122 02 01)
enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

/// Origen del servicio de mantenimiento
/// PROPIO: Taller propio (vinculado a Tarjeta de Mano de Obra)
/// TERCEROS: Taller externo (vinculado a Autorización de Servicio Externo)
enum TipoTaller {
  PROPIO
  TERCEROS
}

/// Estado de la orden de mantenimiento
enum EstadoMantenimiento {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  CANCELADO
}
