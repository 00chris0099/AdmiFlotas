// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: conductores.prisma — Esquema de Conductores y Personal (Normalizado)
// ============================================================

/// Personal del sistema de flotas F1T02 con roles jerárquicos según organigrama
model Usuario {
  id                  String     @id @default(uuid())
  nombre              String     @db.VarChar(100)
  apellido            String     @db.VarChar(100)
  email               String     @unique @db.VarChar(150)
  password            String?    @db.VarChar(255)
  rolId               String?    @map("rol_id")
  activo              Boolean    @default(true)
  telefono            String?    @db.VarChar(20)
  /// Número de licencia de conducir (requerido para conductores)
  licenciaConducir    String?    @map("licencia_conducir") @db.VarChar(30)
  /// Categoría de licencia (A, B, C, D — requerida para conductores)
  categoriaLicencia   String?    @map("categoria_licencia") @db.VarChar(5)
  /// Fecha de vencimiento de la licencia
  vencimientoLicencia DateTime?  @map("vencimiento_licencia")
  /// Especialidad técnica (para mecánicos y electricistas)
  especialidad        String?    @db.VarChar(100)
  ultimoAcceso        DateTime?  @map("ultimo_acceso")
  creadoEn            DateTime   @default(now()) @map("creado_en")
  actualizadoEn       DateTime   @updatedAt @map("actualizado_en")
  bloqueadoHasta      DateTime?  @map("bloqueado_hasta")
  intentosFallidos    Int        @default(0) @map("intentos_fallidos")

  // Relaciones
  rol                  Rol?       @relation(fields: [rolId], references: [id], onDelete: Restrict)
  permisos             PermisoUsuario[]
  sesionesAuth         SesionAuth[]
  auditoria            Auditoria[]
  tokensConfirmacion   TokenConfirmacion[]
  movimientosDiarios   MovimientoDiario[]   @relation("ConductorMovimiento")
  revisionesChecklist  MovimientoDiario[]   @relation("InspectorMovimiento")
  ordenesCombustible   OrdenCombustible[]
  ordenesMantenimiento OrdenMantenimiento[]
  asignaciones         AsignacionVehiculo[]
  programaciones       ProgramacionRuta[]

  @@map("usuarios")
  @@index([rolId])
  @@index([activo])
}
