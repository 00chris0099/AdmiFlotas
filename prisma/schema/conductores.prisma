/// Personal del sistema de flotas F1T02 con roles jerÃ¡rquicos segÃºn organigrama
model Usuario {
  id                  String     @id @default(uuid())
  nombre              String     @db.VarChar(100)
  apellido            String     @db.VarChar(100)
  email               String     @unique @db.VarChar(150)
  password            String?    @db.VarChar(255)
  rol                 RolUsuario @default(ADMINISTRATIVO)
  activo              Boolean    @default(true)
  telefono            String?    @db.VarChar(20)
  /// NÃºmero de licencia de conducir (requerido para conductores)
  licenciaConducir    String?    @map("licencia_conducir") @db.VarChar(30)
  /// CategorÃ­a de licencia (A, B, C, D â€” requerida para conductores)
  categoriaLicencia   String?    @map("categoria_licencia") @db.VarChar(5)
  /// Fecha de vencimiento de la licencia
  vencimientoLicencia DateTime?  @map("vencimiento_licencia")
  /// Especialidad tÃ©cnica (para mecÃ¡nicos y electricistas)
  especialidad        String?    @db.VarChar(100)
  ultimoAcceso        DateTime?  @map("ultimo_acceso")
  creadoEn            DateTime   @default(now()) @map("creado_en")
  actualizadoEn       DateTime   @updatedAt @map("actualizado_en")
  bloqueadoHasta      DateTime?  @map("bloqueado_hasta")
  intentosFallidos    Int        @default(0) @map("intentos_fallidos")

  // Relaciones
  permisos             PermisoUsuario[]
  sesionesAuth         SesionAuth[]
  auditoria            Auditoria[]
  tokensConfirmacion   TokenConfirmacion[]
  movimientosDiarios   MovimientoDiario[]   @relation("ConductorMovimiento")
  revisionesChecklist  MovimientoDiario[]   @relation("InspectorMovimiento")
  ordenesCombustible   OrdenCombustible[]
  ordenesMantenimiento OrdenMantenimiento[]

  @@map("usuarios")
  @@index([rol])
  @@index([activo])
  }

/// Roles jerÃ¡rquicos del organigrama F1T02
/// JEFE_PROCESO: mÃ¡xima autoridad del proceso de gestiÃ³n de flotas
/// CONDUCTOR / INSPECTOR / ANALISTA: Equipo de OperaciÃ³n
/// MECANICO / ELECTRICISTA: Equipo de Mantenimiento
/// ADMINISTRATIVO: Apoyo Administrativo
enum RolUsuario {
  JEFE_PROCESO
  CONDUCTOR
  INSPECTOR
  ANALISTA
  MECANICO
  ELECTRICISTA
  ADMINISTRATIVO

  }
