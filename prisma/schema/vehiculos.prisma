/// VehÃ­culo: tabla central del SAF. Ficha tÃ©cnica patrimonial completa (F1T02 Diagrama 3)
model Vehiculo {
  id String @id @default(uuid())

  // â”€â”€ IdentificaciÃ³n Patrimonial (CÃ³digo 6 dÃ­gitos: CL-CAT-SEQ) â”€â”€
  /// Clase del vehÃ­culo: 01=Terrestre, 02=AcuÃ¡tico, 03=AÃ©reo
  clasePatrimonial     String            @map("clase_patrimonial") @db.VarChar(2)
  /// CategorÃ­a: 01=Pasajeros, 02=Carga, 03=Especial
  categoriaPatrimonial CategoriaVehiculo @map("categoria_patrimonial")
  /// NÃºmero secuencial dentro de la categorÃ­a (001â€“999)
  secuencial           String            @db.VarChar(3)
  /// CÃ³digo patrimonial completo generado: ej. "010200 3" â†’ "01-02-003"
  codigoPatrimonial    String            @unique @map("codigo_patrimonial") @db.VarChar(20)

