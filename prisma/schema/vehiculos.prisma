// ============================================================
// SAF - Sistema de Administracion de Flotas
// Archivo: vehiculos.prisma - Esquema de Vehiculos (Normalizado)
// ============================================================

model Vehiculo {
  id String @id @default(uuid())

  // Identificacion Patrimonial
  clasePatrimonial          String           @map("clase_patrimonial") @db.VarChar(2)
  categoriaPatrimonialId    String?          @map("categoria_patrimonial_id")
  secuencial                String           @db.VarChar(3)
  codigoPatrimonial         String           @unique @map("codigo_patrimonial") @db.VarChar(20)

  // Datos de Registro (Normalizados)
  placa                String  @unique @db.VarChar(10)
  marcaId              String? @map("marca_id")
  modeloId             String? @map("modelo_id")
  anioFabricacion      Int     @map("anio_fabricacion")
  colorId              String? @map("color_id")

  // Especificaciones del Motor y Chasis
  numeroMotor        String?         @unique @map("numero_motor") @db.VarChar(50)
  numeroChasis       String?         @unique @map("numero_chasis") @db.VarChar(50)
  potenciaHp         Int?            @map("potencia_hp")
  cilindraje         Decimal?        @db.Decimal(5, 2)
  numeroCilindros    Int?            @map("numero_cilindros")
  tipoCombustibleId  String?         @map("tipo_combustible_id")
  subtipoCombustible String?         @map("subtipo_combustible") @db.VarChar(50)
  capacidadTanqueGal Decimal?        @map("capacidad_tanque_gal") @db.Decimal(8, 2)

  // Capacidades de Carga y Pasajeros
  capacidadCargaKg   Decimal? @map("capacidad_carga_kg") @db.Decimal(10, 2)
  capacidadPasajeros Int?     @map("capacidad_pasajeros")
  pesoNetoKg         Decimal? @map("peso_neto_kg") @db.Decimal(10, 2)
  pesoBrutoKg        Decimal? @map("peso_bruto_kg") @db.Decimal(10, 2)

  // Especificaciones Electricas de la Bateria
  bateriaTipo     String? @map("bateria_tipo") @db.VarChar(50)
  bateriaCeldas   Int?    @map("bateria_celdas")
  bateriaVoltios  Int?    @map("bateria_voltios")
  bateriaAmperios Int?    @map("bateria_amperios")
  numeroBaterias  Int?    @default(1) @map("numero_baterias")

  // Configuracion de Ejes y Llantas
  numeroEjes              Int?     @map("numero_ejes")
  configuracionEjes       String?  @map("configuracion_ejes") @db.VarChar(30)
  totalLlantas            Int?     @default(4) @map("total_llantas")
  dimensionLlantaEstandar String?  @map("dimension_llanta_estandar") @db.VarChar(30)
  presionLlantaDelantera  Decimal? @map("presion_llanta_delantera") @db.Decimal(5, 2)
  presionLlantaTrasera    Decimal? @map("presion_llanta_trasera") @db.Decimal(5, 2)

  // Inventario Fisico del Vehiculo (EstadoFisico se mantiene como ENUM - 3 valores fijos)
  estadoPintura          EstadoFisico? @map("estado_pintura")
  estadoFaros            EstadoFisico? @map("estado_faros")
  estadoLunas            EstadoFisico? @map("estado_lunas")
  estadoEspejos          EstadoFisico? @map("estado_espejos")
  estadoCarroceria       EstadoFisico? @map("estado_carroceria")
  inventarioHerramientas String?       @map("inventario_herramientas")
  observacionesFisicas   String?       @map("observaciones_fisicas")

  // Costos Fijos del Vehiculo
  valorAdquisicion            Decimal? @map("valor_adquisicion") @db.Decimal(14, 2)
  vidaUtilAnios               Int?     @map("vida_util_anios")
  kmAnualesReferencia         Int?     @map("km_anuales_referencia")
  seguroAnual                 Decimal? @map("seguro_anual") @db.Decimal(12, 2)
  licenciamientoAnual         Decimal? @map("licenciamiento_anual") @db.Decimal(10, 2)
  kmAlertaMantenimiento       Int?     @map("km_alerta_mantenimiento")
  periodicidadMantenimientoKm Int?     @default(5000) @map("periodicidad_mantenimiento_km")
  kilometrajeActual           Int?     @map("kilometraje_actual")

  // Estado Operativo (Normalizado)
  estadoId          String?   @map("estado_id")
  fechaIngreso      DateTime  @default(now()) @map("fecha_ingreso")
  fechaBaja         DateTime? @map("fecha_baja")
  motivoBaja        String?   @map("motivo_baja")
  creadoEn          DateTime  @default(now()) @map("creado_en")
  actualizadoEn     DateTime  @updatedAt @map("actualizado_en")

  // Relaciones (Normalizadas)
  categoriaPatrimonial CategoriaVehiculo? @relation(fields: [categoriaPatrimonialId], references: [id], onDelete: Restrict)
  marca                MarcaVehiculo?     @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  modelo               ModeloVehiculo?    @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  color                ColorVehiculo?     @relation(fields: [colorId], references: [id], onDelete: SetNull)
  tipoCombustible      TipoCombustible?   @relation(fields: [tipoCombustibleId], references: [id], onDelete: Restrict)
  estado               EstadoVehiculo?    @relation(fields: [estadoId], references: [id], onDelete: Restrict)

  // Relaciones existentes
  movimientosDiarios      MovimientoDiario[]
  ordenesCombustible      OrdenCombustible[]
  ordenesMantenimiento    OrdenMantenimiento[]
  controlLlantas          ControlLlanta[]
  reportesMensualesCostos ReporteMensualCostos[]
  desempenoLlantas        DesempenoLlantas[]
  resumenKpisVehiculo     ResumenKpisVehiculo[]
  asignaciones            AsignacionVehiculo[]
  documentos              DocumentoVehiculo[]
  programaciones          ProgramacionRuta[]
  lavados                 Lavado[]

  @@index([placa])
  @@index([estadoId])
  @@index([categoriaPatrimonialId])
  @@index([codigoPatrimonial])
  @@index([tipoCombustibleId])
  @@index([marcaId, modeloId])
  @@map("vehiculos")
}

// ENUMs que se MANTIENEN (domain-specific F1T02, valores fijos)
enum EstadoFisico {
  BUENO
  REGULAR
  MALO
}
