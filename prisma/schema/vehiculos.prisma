  potenciaHp         Int?            @map("potencia_hp")
  cilindraje         Decimal?        @db.Decimal(5, 2)
  numeroCilindros    Int?            @map("numero_cilindros")
  tipoCombustible    TipoCombustible @map("tipo_combustible")
