// ============================================================
// SAF - Sistema de Administracion de Flotas
// Manual F1T02 — Procedimientos Basicos de Operacion y Control
// Archivo: base.prisma — Generadores, fuente de datos y configuracion
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/prisma"
  previewFeatures = ["views", "prismaSchemaFolder"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../ERD.svg"
}

datasource db {
  provider = "postgresql"
}
