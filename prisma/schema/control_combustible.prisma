// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: control_combustible.prisma — Esquema de Control de Combustible (Normalizado)
// ============================================================

/// Orden de abastecimiento de combustible y lubricantes — MA 122 01 02
model OrdenCombustible {
  id                String               @id @default(uuid())
  /// Número de orden correlativo
  numeroOrden       String               @unique @map("numero_orden") @db.VarChar(20)
  fecha             DateTime             @db.Date
  vehiculoId        String               @map("vehiculo_id")
  conductorId       String               @map("conductor_id")
  sectorSolicitanteId String?            @map("sector_solicitante_id")
  tipoCombustible   TipoCombustibleOrden @map("tipo_combustible")
  /// Subtipo de combustible (ej. DIESEL_UBA, GASOLINA_95)
  subtipoCombustible String?             @map("subtipo_combustible") @db.VarChar(50)

  // ─── Combustible ───
  cantidadGalones  Decimal? @map("cantidad_galones") @db.Decimal(8, 2)
  costoGalon       Decimal? @map("costo_galon") @db.Decimal(8, 3)
  costoCombustible Decimal? @map("costo_combustible") @db.Decimal(10, 2)

  // ─── Lubricante — Aceite de Motor (registrado por separado) ───
  /// Indica si esta orden incluye cambio/adición de aceite de motor
  incluyeAceiteMotor    Boolean  @default(false) @map("incluye_aceite_motor")
  cantidadAceiteMotorLt Decimal? @map("cantidad_aceite_motor_lt") @db.Decimal(6, 2)
  marcaAceiteMotor      String?  @map("marca_aceite_motor") @db.VarChar(80)
  viscosidadAceiteMotor String?  @map("viscosidad_aceite_motor") @db.VarChar(20)
  costoAceiteMotor      Decimal? @map("costo_aceite_motor") @db.Decimal(10, 2)

  // ─── Lubricante — Aceite de Caja/Transmisión (registrado por separado) ───
  /// Indica si esta orden incluye cambio de aceite de caja
  incluyeAceiteCaja    Boolean  @default(false) @map("incluye_aceite_caja")
  cantidadAceiteCajaLt Decimal? @map("cantidad_aceite_caja_lt") @db.Decimal(6, 2)
  marcaAceiteCaja      String?  @map("marca_aceite_caja") @db.VarChar(80)
  viscosidadAceiteCaja String?  @map("viscosidad_aceite_caja") @db.VarChar(20)
  costoAceiteCaja      Decimal? @map("costo_aceite_caja") @db.Decimal(10, 2)

  // ─── Costo Total de la Orden ───
  costoTotal Decimal @default(0) @map("costo_total") @db.Decimal(12, 2)

  // ─── Odómetro al momento del abastecimiento ───
  kilometrajeActual Int @map("kilometraje_actual")

  // ─── Datos del Servicentro Acreditado (Normalizado) ───
  centroServicioId          String? @map("centro_servicio_id")
  /// Número de ticket o factura del servicentro
  numeroTicketServiccentro  String? @map("numero_ticket_serviccentro") @db.VarChar(50)
  /// Nombre del responsable que firma/sella en el servicentro
  responsableServiccentro   String? @map("responsable_serviccentro") @db.VarChar(100)
  /// Indica si se recibió el sello del servicentro
  selloServiccentro         Boolean @default(false) @map("sello_serviccentro")

  // ─── Solicitante ───
  /// Localidad donde está ubicado el sector del solicitante
  localidadSolicitante String? @map("localidad_solicitante") @db.VarChar(150)

  // ─── Firmas (MA 122 01 02 - F1T02) ───
  /// Firma del Encargado del Garaje
  firmaEncargadoGaraje String? @map("firma_encargado_garaje") @db.VarChar(100)
  /// Firma del Conductor del vehículo
  firmaConductor String? @map("firma_conductor") @db.VarChar(100)
  /// Firma del Representante del Servicentro
  firmaServiccentro String? @map("firma_servicentro") @db.VarChar(100)

  observaciones String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  vehiculo       Vehiculo              @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  conductor      Usuario               @relation(fields: [conductorId], references: [id], onDelete: Restrict)
  sectorSolicitante SectorOrganizacional? @relation(fields: [sectorSolicitanteId], references: [id], onDelete: SetNull)
  centroServicio CentroServicio?       @relation(fields: [centroServicioId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([vehiculoId, fecha])
  @@index([conductorId])
  @@index([sectorSolicitanteId])
  @@index([centroServicioId])
  @@index([fecha])
  @@index([numeroOrden])
  @@map("ordenes_combustible")
}

/// Tipo de combustible o lubricante en la orden de abastecimiento
enum TipoCombustibleOrden {
  GASOLINA
  DIESEL
  GLP
  ACEITE_MOTOR
  ACEITE_CAJA
  MIXTO
}
