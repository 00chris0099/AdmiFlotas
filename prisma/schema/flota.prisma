// ============================================================
// SAF - Sistema de Administración de Flotas
// Manual F1T02 — Procedimientos Básicos de Operación y Control
// Archivo: flota.prisma — Inventario de Flota y Control de Llantas
// Corresponde a: Formulario de Inventario de Flota (Diagrama 3 del manual)
// ============================================================

// ────────────────────────────────────────────────────────────
// MODELO: Vehiculo
// Tabla central del sistema. Implementa la Ficha Técnica completa
// según el Inventario de Flota del manual F1T02 (Diagrama 3).
//
// Código Patrimonial (6 dígitos): CL-CAT-SEQ
//   CL  = Clase (01=Terrestre, 02=Acuático, 03=Aéreo)
//   CAT = Categoría (01=Pasajeros, 02=Carga, 03=Especial)
//   SEQ = Número secuencial dentro de la categoría (001–999)
//
// Costos Fijos del Vehículo para cálculo CKV:
//   Depreciación = valorAdquisicion / (vidaUtilAnios * kmAnualesRef)
//   CKV = (CostosFijos + CostosVariables) / KmTotales
// ────────────────────────────────────────────────────────────
/// Vehículo: tabla central del SAF. Ficha técnica patrimonial completa (F1T02 Diagrama 3)
model Vehiculo {
  id String @id @default(uuid())

  // ── Identificación Patrimonial (Código 6 dígitos: CL-CAT-SEQ) ──
  /// Clase del vehículo: 01=Terrestre, 02=Acuático, 03=Aéreo
  clasePatrimonial     String            @map("clase_patrimonial") @db.VarChar(2)
  /// Categoría: 01=Pasajeros, 02=Carga, 03=Especial
  categoriaPatrimonial CategoriaVehiculo @map("categoria_patrimonial")
  /// Número secuencial dentro de la categoría (001–999)
  secuencial           String            @db.VarChar(3)
  /// Código patrimonial completo generado: ej. "010200 3" → "01-02-003"
  codigoPatrimonial    String            @unique @map("codigo_patrimonial") @db.VarChar(20)

  // ── Datos de Registro ──
  placa           String  @unique @db.VarChar(10)
  marca           String  @db.VarChar(80)
  modelo          String  @db.VarChar(80)
  anioFabricacion Int     @map("anio_fabricacion")
  color           String? @db.VarChar(50)

  // ── Especificaciones del Motor y Chasis ──
  numeroMotor        String?         @unique @map("numero_motor") @db.VarChar(50)
  numeroChasis       String?         @unique @map("numero_chasis") @db.VarChar(50)
  potenciaHp         Int?            @map("potencia_hp")
  cilindraje         Decimal?        @db.Decimal(5, 2)
  numeroCilindros    Int?            @map("numero_cilindros")
  tipoCombustible    TipoCombustible @map("tipo_combustible")
  capacidadTanqueGal Decimal?        @map("capacidad_tanque_gal") @db.Decimal(8, 2)

  // ── Capacidades de Carga y Pasajeros ──
  capacidadCargaKg   Decimal? @map("capacidad_carga_kg") @db.Decimal(10, 2)
  capacidadPasajeros Int?     @map("capacidad_pasajeros")
  pesoNetoKg         Decimal? @map("peso_neto_kg") @db.Decimal(10, 2)
  pesoBrutoKg        Decimal? @map("peso_bruto_kg") @db.Decimal(10, 2)

  // ── Especificaciones Eléctricas de la Batería ──
  /// Tipo de batería (ej. Plomo-Ácido, AGM, Gel)
  bateriaTipo     String? @map("bateria_tipo") @db.VarChar(50)
  /// Número de celdas de la batería
  bateriaCeldas   Int?    @map("bateria_celdas")
  /// Voltaje nominal de la batería (6V, 12V, 24V)
  bateriaVoltios  Int?    @map("bateria_voltios")
  /// Amperaje/Capacidad en Ah
  bateriaAmperios Int?    @map("bateria_amperios")
  /// Número de baterías instaladas
  numeroBaterias  Int?    @default(1) @map("numero_baterias")

  // ── Configuración de Ejes y Llantas ──
  numeroEjes              Int?     @map("numero_ejes")
  configuracionEjes       String?  @map("configuracion_ejes") @db.VarChar(30)
  /// Número total de llantas (incluyendo repuesto)
  totalLlantas            Int?     @default(4) @map("total_llantas")
  dimensionLlantaEstandar String?  @map("dimension_llanta_estandar") @db.VarChar(30)
  presionLlantaDelantera  Decimal? @map("presion_llanta_delantera") @db.Decimal(5, 2)
  presionLlantaTrasera    Decimal? @map("presion_llanta_trasera") @db.Decimal(5, 2)

  // ── Inventario Físico del Vehículo (Diagrama 3 — Estado Visual) ──
  /// Estado de la pintura: BUENO / REGULAR / MALO
  estadoPintura          EstadoFisico? @map("estado_pintura")
  /// Estado de los faros delanteros
  estadoFaros            EstadoFisico? @map("estado_faros")
  /// Estado de las lunas/vidrios
  estadoLunas            EstadoFisico? @map("estado_lunas")
  /// Estado de los espejos retrovisores
  estadoEspejos          EstadoFisico? @map("estado_espejos")
  /// Estado general de la carrocería
  estadoCarroceria       EstadoFisico? @map("estado_carroceria")
  /// Inventario de herramientas y accesorios (texto libre o JSON)
  inventarioHerramientas String?       @map("inventario_herramientas")
  /// Observaciones generales del estado físico
  observacionesFisicas   String?       @map("observaciones_fisicas")

  // ── Costos Fijos del Vehículo — Soporte para CKV ──
  /// Valor de adquisición del vehículo (para cálculo de depreciación)
  valorAdquisicion            Decimal? @map("valor_adquisicion") @db.Decimal(14, 2)
  /// Vida útil estimada en años (para cálculo de depreciación)
  vidaUtilAnios               Int?     @map("vida_util_anios")
  /// Kilómetros anuales de referencia para prorratear depreciación
  kmAnualesReferencia         Int?     @map("km_anuales_referencia")
  /// Prima de seguro anual del vehículo
  seguroAnual                 Decimal? @map("seguro_anual") @db.Decimal(12, 2)
  /// Costo anual de licenciamiento y SOAT
  licenciamientoAnual         Decimal? @map("licenciamiento_anual") @db.Decimal(10, 2)
  /// Kilometraje en que se activó la alerta de mantenimiento preventivo
  kmAlertaMantenimiento       Int?     @map("km_alerta_mantenimiento")
  /// Periodicidad de mantenimiento preventivo en km (según fabricante)
  periodicidadMantenimientoKm Int?     @default(5000) @map("periodicidad_mantenimiento_km")

  // ── Estado Operativo ──
  estado        EstadoVehiculo @default(OPERATIVO)
  fechaIngreso  DateTime       @default(now()) @map("fecha_ingreso")
  fechaBaja     DateTime?      @map("fecha_baja")
  motivoBaja    String?        @map("motivo_baja")
  creadoEn      DateTime       @default(now()) @map("creado_en")
  actualizadoEn DateTime       @updatedAt @map("actualizado_en")

  // ── Relaciones ──
  movimientosDiarios     MovimientoDiario[]
  ordenesCombustible     OrdenCombustible[]
  ordenesMantenimiento   OrdenMantenimiento[]
  controlLlantas         ControlLlanta[]
  reportesMensualesCostos ReporteMensualCostos[]

  @@index([placa])
  @@index([estado])
  @@index([categoriaPatrimonial])
  @@index([codigoPatrimonial])
  @@map("vehiculos")
}

// ────────────────────────────────────────────────────────────
// MODELO: ControlLlanta
// Control individualizado de llantas por el alto costo que representan.
// Cada llanta se identifica por su código EPS (Número EPS) y se registra
// su posición en el vehículo según el diagrama del manual (posición 1–7).
//
// Diagrama de posiciones (ejemplo camión 6 llantas + 1 repuesto):
//   [1]Delantera-Izq  [2]Delantera-Der
//   [3]Trasera-Izq-Ext  [4]Trasera-Izq-Int
//   [5]Trasera-Der-Int  [6]Trasera-Der-Ext
//   [7]Repuesto
// ────────────────────────────────────────────────────────────
/// Control individualizado de llantas: código EPS, posición, kilometraje acumulado
model ControlLlanta {
  id                     String       @id @default(uuid())
  /// Código único de la llanta (Número EPS del fabricante)
  codigoEps              String       @unique @map("codigo_eps") @db.VarChar(50)
  vehiculoId             String       @map("vehiculo_id")
  fabricante             String       @db.VarChar(80)
  dimension              String       @db.VarChar(30)
  modeloLlanta           String       @map("modelo_llanta") @db.VarChar(80)
  /// Posición en el vehículo según diagrama del manual (1–7)
  posicionVehiculo       Int          @map("posicion_vehiculo")
  /// Descripción textual de la posición (ej. "Delantera Izquierda")
  descripcionPosicion    String?      @map("descripcion_posicion") @db.VarChar(50)
  estado                 EstadoLlanta @default(EN_USO)
  fechaInstalacion       DateTime     @map("fecha_instalacion")
  fechaRetiro            DateTime?    @map("fecha_retiro")
  /// Kilometraje del vehículo al momento de instalar la llanta
  kilometrajeInstalacion Int          @map("kilometraje_instalacion")
  /// Kilometraje del vehículo al momento de retirar la llanta
  kilometrajeRetiro      Int?         @map("kilometraje_retiro")
  /// Km recorridos con esta llanta = kmRetiro - kmInstalacion
  kilometrajeAcumulado   Int          @default(0) @map("kilometraje_acumulado")
  /// Número de veces que ha sido reencauchada
  veceReencauchada       Int          @default(0) @map("veces_reencauchada")
  /// Costo de adquisición de la llanta
  costoAdquisicion       Decimal?     @map("costo_adquisicion") @db.Decimal(10, 2)
  observaciones          String?
  creadoEn               DateTime     @default(now()) @map("creado_en")
  actualizadoEn          DateTime     @updatedAt @map("actualizado_en")
  vehiculo               Vehiculo     @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId])
  @@index([estado])
  @@index([codigoEps])
  @@map("control_llantas")
}

// ────────────────────────────────────────────────────────────
// ENUMs de Flota
// ────────────────────────────────────────────────────────────

/// Categorías patrimoniales del vehículo según clasificación F1T02
enum CategoriaVehiculo {
  PASAJEROS
  CARGA
  ESPECIAL
}

/// Tipos de combustible del vehículo
enum TipoCombustible {
  GASOLINA
  DIESEL
  GLP
  ELECTRICO
  HIBRIDO
}

/// Estado operativo del vehículo
enum EstadoVehiculo {
  OPERATIVO
  EN_MANTENIMIENTO
  INOPERATIVO
  DADO_DE_BAJA
}

/// Estado físico de componentes visuales del vehículo (Diagrama 3)
enum EstadoFisico {
  BUENO
  REGULAR
  MALO
}

/// Estado de una llanta según su ciclo de vida
enum EstadoLlanta {
  EN_USO
  EN_ALMACEN
  REENCAUCHADA
  EN_REENCAUCHE
  DADA_DE_BAJA
}
