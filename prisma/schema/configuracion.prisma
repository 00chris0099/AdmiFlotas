/// ParÃ¡metros generales del sistema SAF (nombre de la unidad, metas de km, etc.)
model ConfiguracionFlota {
  id            String   @id @default(uuid())
  clave         String   @unique @db.VarChar(100)
  valor         String
  descripcion   String?
