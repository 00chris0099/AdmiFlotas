// ============================================================
// SAF - Sistema de Administración de Flotas
// Manual F1T02 — Procedimientos Básicos de Operación y Control
// Archivo: seguridad.prisma — Personal, Roles y Seguridad del Sistema
// Organigrama: Jefe de Proceso → Operación / Mantenimiento / Administrativo
// ============================================================

// ────────────────────────────────────────────────────────────
// MODELO: Usuario
// Integrantes del equipo según el organigrama F1T02.
// Roles jerárquicos: Jefe de Proceso, Equipo de Operación
// (Conductores, Inspectores, Analistas), Equipo de Mantenimiento
// (Mecánicos, Electricistas) y Apoyo Administrativo.
// Usuarios iniciales: Escriba Matto, Leon Mejia, Montero Salazar,
//                     Polanco Jimenez, Ventura Chipana
// ────────────────────────────────────────────────────────────
/// Personal del sistema de flotas F1T02 con roles jerárquicos según organigrama
model Usuario {
  id                  String     @id @default(uuid())
  nombre              String     @db.VarChar(100)
  apellido            String     @db.VarChar(100)
  email               String     @unique @db.VarChar(150)
  password            String     @db.VarChar(255)
  rol                 RolUsuario @default(ADMINISTRATIVO)
  activo              Boolean    @default(true)
  telefono            String?    @db.VarChar(20)
  /// Número de licencia de conducir (requerido para conductores)
  licenciaConducir    String?    @map("licencia_conducir") @db.VarChar(30)
  /// Categoría de licencia (A, B, C, D — requerida para conductores)
  categoriaLicencia   String?    @map("categoria_licencia") @db.VarChar(5)
  /// Fecha de vencimiento de la licencia
  vencimientoLicencia DateTime?  @map("vencimiento_licencia")
  /// Especialidad técnica (para mecánicos y electricistas)
  especialidad        String?    @db.VarChar(100)
  ultimoAcceso        DateTime?  @map("ultimo_acceso")
  creadoEn            DateTime   @default(now()) @map("creado_en")
  actualizadoEn       DateTime   @updatedAt @map("actualizado_en")
  bloqueadoHasta      DateTime?  @map("bloqueado_hasta")
  intentosFallidos    Int        @default(0) @map("intentos_fallidos")

  // Relaciones
  permisos             PermisoUsuario[]
  sesionesAuth         SesionAuth[]
  auditoria            Auditoria[]
  movimientosDiarios   MovimientoDiario[]   @relation("ConductorMovimiento")
  revisionesChecklist  MovimientoDiario[]   @relation("InspectorMovimiento")
  ordenesCombustible   OrdenCombustible[]
  ordenesMantenimiento OrdenMantenimiento[]

  @@map("usuarios")
}

// ────────────────────────────────────────────────────────────
// MODELO: Permiso — Control granular por módulo y acción
// ────────────────────────────────────────────────────────────
/// Permisos granulares del sistema SAF (módulo + acción)
model Permiso {
  id          String           @id @default(uuid())
  modulo      String           @db.VarChar(50)
  accion      String           @db.VarChar(50)
  descripcion String?
  creadoEn    DateTime         @default(now()) @map("creado_en")
  usuarios    PermisoUsuario[]

  @@unique([modulo, accion])
  @@map("permisos")
}

/// Tabla pivote: asignación de permisos a usuarios
model PermisoUsuario {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  permisoId  String   @map("permiso_id")
  otorgadoEn DateTime @default(now()) @map("otorgado_en")
  permiso    Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permisoId])
  @@index([usuarioId])
  @@index([permisoId])
  @@map("permisos_usuario")
}

// ────────────────────────────────────────────────────────────
// MODELO: SesionAuth — Sesiones de autenticación activas
// ────────────────────────────────────────────────────────────
/// Sesiones de autenticación activas en el sistema SAF
model SesionAuth {
  id         String           @id @default(uuid())
  usuarioId  String           @map("usuario_id")
  token      String           @unique @db.VarChar(500)
  ipAddress  String?          @map("ip_address") @db.VarChar(45)
  userAgent  String?          @map("user_agent")
  estado     EstadoSesionAuth @default(ACTIVA)
  iniciadaEn DateTime         @default(now()) @map("iniciada_en")
  expiraEn   DateTime         @map("expira_en")
  cerradaEn  DateTime?        @map("cerrada_en")
  usuario    Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([token])
  @@index([estado])
  @@map("sesiones_auth")
}

// ────────────────────────────────────────────────────────────
// MODELO: Auditoria — Trazabilidad de acciones críticas
// ────────────────────────────────────────────────────────────
/// Registro de auditoría: toda acción crítica del sistema SAF
model Auditoria {
  id           String              @id @default(uuid())
  usuarioId    String?             @map("usuario_id")
  accion       TipoAccionAuditoria
  modulo       String              @db.VarChar(50)
  entidad      String              @db.VarChar(50)
  entidadId    String?             @map("entidad_id") @db.VarChar(100)
  datosAntes   String?             @map("datos_antes")
  datosDespues String?             @map("datos_despues")
  ipAddress    String?             @map("ip_address") @db.VarChar(45)
  descripcion  String?
  creadoEn     DateTime            @default(now()) @map("creado_en")
  usuario      Usuario?            @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([accion])
  @@index([modulo])
  @@index([creadoEn])
  @@map("auditoria")
}

// ────────────────────────────────────────────────────────────
// ENUMs de Seguridad y Personal
// ────────────────────────────────────────────────────────────

/// Roles jerárquicos del organigrama F1T02
/// JEFE_PROCESO: máxima autoridad del proceso de gestión de flotas
/// CONDUCTOR / INSPECTOR / ANALISTA: Equipo de Operación
/// MECANICO / ELECTRICISTA: Equipo de Mantenimiento
/// ADMINISTRATIVO: Apoyo Administrativo
enum RolUsuario {
  JEFE_PROCESO
  CONDUCTOR
  INSPECTOR
  ANALISTA
  MECANICO
  ELECTRICISTA
  ADMINISTRATIVO
}

/// Estados de una sesión de autenticación
enum EstadoSesionAuth {
  ACTIVA
  EXPIRADA
  CERRADA
  BLOQUEADA
}

/// Tipos de acción para auditoría del sistema
enum TipoAccionAuditoria {
  LOGIN
  LOGOUT
  CREAR
  ACTUALIZAR
  ELIMINAR
  CONSULTAR
  EXPORTAR
  CONFIGURAR
  ALERTA_MANTENIMIENTO
}
