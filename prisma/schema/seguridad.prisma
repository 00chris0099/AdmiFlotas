// MODELO: SesionAuth â€” Sesiones de autenticaciÃ³n activas
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Sesiones de autenticaciÃ³n activas en el sistema SAF
model SesionAuth {
  id         String           @id @default(uuid())
  usuarioId  String           @map("usuario_id")
  token      String           @unique @db.VarChar(500)
  ipAddress  String?          @map("ip_address") @db.VarChar(45)
  userAgent  String?          @map("user_agent")
  estado     EstadoSesionAuth @default(ACTIVA)
  iniciadaEn DateTime         @default(now()) @map("iniciada_en")
  expiraEn   DateTime         @map("expira_en")
  cerradaEn  DateTime?        @map("cerrada_en")
  usuario    Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([token])
  @@index([estado])
  @@map("sesiones_auth")
  }

