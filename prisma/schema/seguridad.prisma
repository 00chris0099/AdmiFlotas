/// Estados de una sesiÃ³n de autenticaciÃ³n
enum EstadoSesionAuth {
  ACTIVA
  EXPIRADA
  CERRADA
  BLOQUEADA

  }

/// Tipos de acciÃ³n para auditorÃ­a del sistema
enum TipoAccionAuditoria {
  LOGIN
  LOGOUT
  CREAR
  ACTUALIZAR
  ELIMINAR
  CONSULTAR
  EXPORTAR
  CONFIGURAR
  ALERTA_MANTENIMIENTO

  }

