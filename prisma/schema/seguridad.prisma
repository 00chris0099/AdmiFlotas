// MODELO: Permiso â€” Control granular por mÃ³dulo y acciÃ³n
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Permisos granulares del sistema SAF (mÃ³dulo + acciÃ³n)
model Permiso {
  id          String           @id @default(uuid())
  modulo      String           @db.VarChar(50)
  accion      String           @db.VarChar(50)
  descripcion String?
  creadoEn    DateTime         @default(now()) @map("creado_en")
  usuarios    PermisoUsuario[]

  @@unique([modulo, accion])
  @@map("permisos")
  }

/// Tabla pivote: asignaciÃ³n de permisos a usuarios
model PermisoUsuario {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  permisoId  String   @map("permiso_id")
  otorgadoEn DateTime @default(now()) @map("otorgado_en")
  permiso    Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permisoId])
  @@map("permisos_usuario")
  @@index([usuarioId])
  @@index([permisoId])
  }

