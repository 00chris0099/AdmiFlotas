// MODELO: Auditoria â€” Trazabilidad de acciones crÃ­ticas
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Registro de auditorÃ­a: toda acciÃ³n crÃ­tica del sistema SAF
model Auditoria {
  id           String              @id @default(uuid())
  usuarioId    String?             @map("usuario_id")
  accion       TipoAccionAuditoria
  modulo       String              @db.VarChar(50)
  entidad      String              @db.VarChar(50)
  entidadId    String?             @map("entidad_id") @db.VarChar(100)
  datosAntes   String?             @map("datos_antes")
  datosDespues String?             @map("datos_despues")
  ipAddress    String?             @map("ip_address") @db.VarChar(45)
  descripcion  String?
  creadoEn     DateTime            @default(now()) @map("creado_en")
  usuario      Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([accion])
  @@index([modulo])
  @@index([creadoEn])
  @@map("auditoria")
  }

