// ============================================================
// SAF - Sistema de Administración de Flotas
// Archivo: control_llantas.prisma — Esquema de Control de Llantas (Normalizado)
// ============================================================

/// Control individualizado de llantas: código EPS, posición, kilometraje acumulado
model ControlLlanta {
  id                     String       @id @default(uuid())
  /// Código único de la llanta (Número EPS del fabricante)
  codigoEps              String       @unique @map("codigo_eps") @db.VarChar(50)
  vehiculoId             String       @map("vehiculo_id")
  fabricanteId           String?      @map("fabricante_id")
  dimensionId            String?      @map("dimension_id")
  modeloLlanta           String       @map("modelo_llanta") @db.VarChar(80)
  /// Posición en el vehículo según diagrama del manual (1–7)
  posicionVehiculo       Int          @map("posicion_vehiculo")
  /// Descripción textual de la posición (ej. "Delantera Izquierda")
  descripcionPosicion    String?      @map("descripcion_posicion") @db.VarChar(50)
  estado                 EstadoLlanta @default(EN_USO)
  fechaInstalacion       DateTime     @map("fecha_instalacion")
  fechaRetiro            DateTime?    @map("fecha_retiro")
  /// Kilometraje del vehículo al momento de instalar la llanta
  kilometrajeInstalacion Int          @map("kilometraje_instalacion")
  /// Kilometraje del vehículo al momento de retirar la llanta
  kilometrajeRetiro      Int?         @map("kilometraje_retiro")
  /// Km recorridos con esta llanta = kmRetiro - kmInstalacion
  kilometrajeAcumulado   Int          @default(0) @map("kilometraje_acumulado")
  /// Número de veces que ha sido reencauchada
  vecesReencauchada       Int          @default(0) @map("veces_reencauchada")
  /// Costo de adquisición de la llanta
  costoAdquisicion       Decimal?     @map("costo_adquisicion") @db.Decimal(10, 2)
  observaciones          String?
  creadoEn               DateTime     @default(now()) @map("creado_en")
  actualizadoEn          DateTime     @updatedAt @map("actualizado_en")

  // Relaciones
  vehiculo   Vehiculo          @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  fabricante FabricanteLlanta?  @relation(fields: [fabricanteId], references: [id], onDelete: Restrict)
  dimension  DimensionLlanta?   @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@index([vehiculoId])
  @@index([fabricanteId])
  @@index([dimensionId])
  @@index([estado])
  @@index([codigoEps])
  @@index([fechaInstalacion])
  @@index([posicionVehiculo])
  @@map("control_llantas")
}

/// Estado de una llanta según su ciclo de vida
enum EstadoLlanta {
  EN_USO
  EN_ALMACEN
  REENCAUCHADA
  EN_REENCAUCHE
  DADA_DE_BAJA
}

/// Vista analítica de desempeño y coste por kilómetro de neumáticos
view DesempenoLlantas {
  id                     String   @unique
  codigoEps              String   @map("codigo_eps")
  vehiculoId             String   @map("vehiculo_id")
  fabricante             String
  kilometrajeAcumulado   Int      @map("kilometraje_acumulado")
  vecesReencauchada      Int      @map("veces_reencauchada")
  costoAdquisicion       Decimal? @map("costo_adquisicion") @db.Decimal(10, 2)
  costoPorKm             Decimal? @map("costo_por_km") @db.Decimal(10, 4)

  vehiculo               Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("v_desempeno_llantas")
}
