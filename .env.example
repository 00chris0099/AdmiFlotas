# ============================================================
# SAF - Variables de Entorno (Ejemplo)
# Copiar a .env y completar los valores
# ============================================================

# ─── Base de Datos ───
DATABASE_URL=postgresql://flotas:saf_password@localhost:5432/flotas

# ─── JWT ───
JWT_SECRET=tu-secreto-jwt-minimo-32-caracteres-aqui
JWT_EXPIRES_IN=8h

# ─── SMTP ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=SAF Flotas <tu-email@gmail.com>

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Docker ───
DB_PASSWORD=saf_password
